{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Equipment available in the catalog",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "year": { "type": "number" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "serie": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "specs": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "brand", "model", "year", "category", "description", "images"]
    },
    "AllowedAdmin": {
      "title": "Allowed Admin",
      "description": "Email address allowed to access the admin panel",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" }
      },
      "required": ["email"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer testimonial",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "photoUrl": { "type": "string" },
        "text": { "type": "string" },
        "rating": { "type": "number" },
        "role": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "photoUrl", "text", "rating"]
    },
    "GalleryImage": {
      "title": "Gallery Image",
      "description": "Image stored in the global gallery",
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "name": { "type": "string" },
        "size": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["url", "name", "size"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global application settings",
      "type": "object",
      "properties": {
        "showPreloader": { "type": "boolean" },
        "logoDark": { "type": "string" },
        "logoLight": { "type": "string" },
        "isotypeDark": { "type": "string" },
        "isotypeLight": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of products"
    },
    "/allowed_admins/{email}": {
      "schema": "AllowedAdmin",
      "description": "Whitelist of admin emails"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer reviews"
    },
    "/galeria/{imageId}": {
      "schema": "GalleryImage",
      "description": "Global image gallery"
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Configuration settings"
    }
  }
}
