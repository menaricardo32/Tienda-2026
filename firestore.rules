rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email == 'menaricardo333@gmail.com' ||
         exists(/databases/$(database)/documents/allowed_admins/$(request.auth.token.email)));
    }

    // Products & Categories: Publicly readable, Admin writable
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Gallery: Publicly readable, Admin writable
    match /galeria/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings (Branding & Content): Publicly readable, Admin writable
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // FAQs: Publicly readable, Admin writable
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Locations: Publicly readable, Admin writable
    match /locations/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews: Publicly readable, Admin writable
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Stats: Publicly readable (for dashboard), Admin writable
    match /stats/{statId} {
      allow read: if true;
      allow write: if true; // Allow incrementing visits from client
    }

    // Allowed Admins: Only Admin can read/write
    match /allowed_admins/{email} {
      allow read: if isAuthenticated() && (request.auth.token.email == email || isAdmin());
      allow write: if isAdmin();
    }

    // Users: Private, Admin can read all
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId || isAdmin();
    }
  }
}
